DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# Envoi d'emails transactionnels via le SMTP Gmail (voir app/core/email.py).
# SMTP_USER : ton adresse Gmail. SMTP_PASSWORD : un "mot de passe
# d'application" généré sur https://myaccount.google.com/apppasswords
# (nécessite la validation en 2 étapes activée sur le compte Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_SENDER_NAME=Sunu Boutik

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

FRONTEND_URL=http://localhost:3000
